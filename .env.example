# Supabase (required) — from Project Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Server-only — never prefix with VITE_ (not shipped to the browser)
# Used for privileged scripts / admin ops; not for normal request auth.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ---------------------------------------------------------------------------
# Dashboard settings (Auth)
# ---------------------------------------------------------------------------
# Confirm email: OFF (Authentication → Providers → Email → Confirm email)
#   so signup can sign in immediately without verifying.
#
# Site URL + Redirect URLs (Authentication → URL Configuration), e.g.:
#   http://localhost:3000
#   http://localhost:3000/auth/callback
#   http://localhost:3000/reset-password
#   (plus production origins when deployed)
#
# Optional email templates for confirm + recovery still work when Confirm
# email is off; verification is optional for app use but required for
# password reset.
